# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Authentication & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Providers (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
GROQ_API_KEY=

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=10
MAX_PARSE_SECONDS=30

# Background Tasks & Worker Settings
TASK_POLL_INTERVAL_SECONDS=5
TASK_MAX_RETRIES=3
TASK_CLAIM_TIMEOUT_SECONDS=300

# Storage Buckets (Supabase Storage)
SIGNED_URL_EXPIRY_SECONDS=3600
STORAGE_RESUME_BUCKET=resumes
STORAGE_DOCUMENTS_BUCKET=tailored-documents

# Anti-Hallucination & Fabrication Validator Ratios
FAB_BULLET_RATIO=0.65
FAB_LETTER_RATIO=0.55
FAB_SKILL_RATIO=0.85

# Observability (Optional)
OPIK_API_KEY=
ENABLE_LLM_TRACING=false

# Job Discovery via Apify LinkedIn Scraper
APIFY_API_TOKEN=your-apify-api-token
APIFY_ACTOR_ID=curious_coder~linkedin-jobs-scraper
